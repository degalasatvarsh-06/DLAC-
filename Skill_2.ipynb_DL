{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"16wcjvYhssAFTkG6pccppemuyknkEhVSb","timestamp":1795417148253}]},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":1,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"A_5jmyX0jc7v","outputId":"4af82302-5578-4d71-a735-0b62531bd39d","executionInfo":{"status":"ok","timestamp":1795417014124,"user_tz":-330,"elapsed":59531,"user":{"displayName":"Satvarsh Degala","userId":"17282089235254412255"}}},"outputs":[{"output_type":"stream","name":"stdout","text":["Creating new Ultralytics Settings v0.0.8 file ✅ \n","View Ultralytics Settings with 'yolo settings' or at '/root/.config/Ultralytics/settings.json'\n","Update Settings with 'yolo settings key=value', i.e. 'yolo settings runs_dir=path/to/dir'. For help see https://docs.ultralytics.com/usage/settings\n","=================================================================\n","       VISIONPORT - END-TO-END SYSTEM ARCHITECTURE\n","=================================================================\n","\n","SYSTEM CONFIGURATION\n","---------------------------------------------\n","PyTorch Version: 2.14.1+cpu\n","GPU Available: False\n","Hardware: CPU\n","TensorRT: Not installed\n","Triton Client Installed: False\n","Triton Server Running: False\n","\n","UPLOAD YOUR INPUT IMAGE\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","     <input type=\"file\" id=\"files-28cf10c1-92ba-4fda-b769-21e4882c0981\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-28cf10c1-92ba-4fda-b769-21e4882c0981\">\n","      Upload widget is only available when the cell has been executed in the\n","      current browser session. Please rerun this cell to enable.\n","      </output>\n","      <script>// Copyright 2017 Google LLC\n","//\n","// Licensed under the Apache License, Version 2.0 (the \"License\");\n","// you may not use this file except in compliance with the License.\n","// You may obtain a copy of the License at\n","//\n","//      http://www.apache.org/licenses/LICENSE-2.0\n","//\n","// Unless required by applicable law or agreed to in writing, software\n","// distributed under the License is distributed on an \"AS IS\" BASIS,\n","// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n","// See the License for the specific language governing permissions and\n","// limitations under the License.\n","\n","/**\n"," * @fileoverview Helpers for google.colab Python module.\n"," */\n","(function(scope) {\n","function span(text, styleAttributes = {}) {\n","  const element = document.createElement('span');\n","  element.textContent = text;\n","  for (const key of Object.keys(styleAttributes)) {\n","    element.style[key] = styleAttributes[key];\n","  }\n","  return element;\n","}\n","\n","// Max number of bytes which will be uploaded at a time.\n","const MAX_PAYLOAD_SIZE = 100 * 1024;\n","\n","function _uploadFiles(inputId, outputId) {\n","  const steps = uploadFilesStep(inputId, outputId);\n","  const outputElement = document.getElementById(outputId);\n","  // Cache steps on the outputElement to make it available for the next call\n","  // to uploadFilesContinue from Python.\n","  outputElement.steps = steps;\n","\n","  return _uploadFilesContinue(outputId);\n","}\n","\n","// This is roughly an async generator (not supported in the browser yet),\n","// where there are multiple asynchronous steps and the Python side is going\n","// to poll for completion of each step.\n","// This uses a Promise to block the python side on completion of each step,\n","// then passes the result of the previous step as the input to the next step.\n","function _uploadFilesContinue(outputId) {\n","  const outputElement = document.getElementById(outputId);\n","  const steps = outputElement.steps;\n","\n","  const next = steps.next(outputElement.lastPromiseValue);\n","  return Promise.resolve(next.value.promise).then((value) => {\n","    // Cache the last promise value to make it available to the next\n","    // step of the generator.\n","    outputElement.lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saving Screenshot 2026-11-23 122041.png to Screenshot 2026-11-23 122041.png\n","\n","Loading YOLOv8 Model...\n","\u001b[KDownloading https://github.com/ultralytics/assets/releases/download/v8.4.0/yolov8n.pt to 'yolov8n.pt': 100% ━━━━━━━━━━━━ 6.2MB 80.0MB/s 0.1s\n","YOLOv8 Model Loaded Successfully!\n","\n","FASTAPI SERVER STARTED SUCCESSFULLY!\n","API Address: http://127.0.0.1:8000\n","Health Endpoint: /health\n","Prediction Endpoint: /predict\n","\n","Sending Image Through HTTP POST Request...\n","\n","API RESPONSE RECEIVED!\n","Status: success\n","Total Objects: 6\n","Inference Time: 10190.98 ms\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1600x700 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x900 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 900x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","=================================================================\n","             VISIONPORT FINAL SYSTEM REPORT\n","=================================================================\n","Image Acquisition       : SUCCESS\n","FastAPI Server           : RUNNING\n","HTTP POST Request        : SUCCESS\n","YOLOv8 Model             : LOADED\n","Object Detection         : COMPLETED\n","Bounding Boxes           : GENERATED\n","JSON Response            : RECEIVED\n","GPU Available            : False\n","TensorRT Available       : False\n","Triton Client Available  : False\n","Triton Server Running    : False\n","Total Objects Detected   : 6\n","Inference Time           : 10190.98 ms\n","=================================================================\n","\n","VISIONPORT END-TO-END PIPELINE COMPLETED!\n"]}],"source":["\n","# ============================================================\n","# VISIONPORT EXPERIMENT 2\n","# END-TO-END DEEP LEARNING SYSTEM ARCHITECTURE\n","# FastAPI + Triton + TensorRT + YOLO + GPU\n","# ============================================================\n","\n","# 1. INSTALL DEPENDENCIES\n","!pip install -q ultralytics fastapi uvicorn python-multipart requests\n","\n","# 2. IMPORT LIBRARIES\n","import os\n","import time\n","import threading\n","import requests\n","import cv2\n","import torch\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import matplotlib.patches as patches\n","\n","from ultralytics import YOLO\n","from fastapi import FastAPI, UploadFile, File\n","from fastapi.responses import JSONResponse\n","from google.colab import files\n","from io import BytesIO\n","from PIL import Image\n","import uvicorn\n","\n","print(\"=\" * 65)\n","print(\"       VISIONPORT - END-TO-END SYSTEM ARCHITECTURE\")\n","print(\"=\" * 65)\n","\n","# 3. CHECK HARDWARE AND SOFTWARE\n","gpu_available = torch.cuda.is_available()\n","\n","if gpu_available:\n","    gpu_name = torch.cuda.get_device_name(0)\n","    hardware = gpu_name\n","else:\n","    gpu_name = \"No NVIDIA GPU detected\"\n","    hardware = \"CPU\"\n","\n","print(\"\\nSYSTEM CONFIGURATION\")\n","print(\"-\" * 45)\n","print(\"PyTorch Version:\", torch.__version__)\n","print(\"GPU Available:\", gpu_available)\n","print(\"Hardware:\", hardware)\n","\n","# Check TensorRT\n","try:\n","    import tensorrt as trt\n","    tensorrt_available = True\n","    trt_version = trt.__version__\n","except Exception:\n","    tensorrt_available = False\n","    trt_version = \"Not installed\"\n","\n","# Check Triton client availability\n","try:\n","    import tritonclient\n","    triton_client_available = True\n","except Exception:\n","    triton_client_available = False\n","\n","# Check Triton server health endpoint\n","try:\n","    triton_response = requests.get(\n","        \"http://localhost:8000/v2/health/ready\",\n","        timeout=2\n","    )\n","    triton_running = triton_response.status_code == 200\n","except Exception:\n","    triton_running = False\n","\n","print(\"TensorRT:\", trt_version)\n","print(\"Triton Client Installed:\", triton_client_available)\n","print(\"Triton Server Running:\", triton_running)\n","\n","# 4. UPLOAD IMAGE\n","print(\"\\nUPLOAD YOUR INPUT IMAGE\")\n","uploaded = files.upload()\n","\n","image_path = list(uploaded.keys())[0]\n","\n","# 5. LOAD YOLO MODEL\n","print(\"\\nLoading YOLOv8 Model...\")\n","model = YOLO(\"yolov8n.pt\")\n","\n","print(\"YOLOv8 Model Loaded Successfully!\")\n","\n","# 6. CREATE FASTAPI APPLICATION\n","app = FastAPI(\n","    title=\"VisionPort Inference API\",\n","    description=\"End-to-End Deep Learning Image Detection API\",\n","    version=\"1.0\"\n",")\n","\n","@app.get(\"/\")\n","def home():\n","    return {\n","        \"project\": \"VisionPort\",\n","        \"status\": \"Running\",\n","        \"model\": \"YOLOv8 Nano\"\n","    }\n","\n","@app.get(\"/health\")\n","def health():\n","    return {\n","        \"api_status\": \"Healthy\",\n","        \"model_loaded\": True,\n","        \"hardware\": hardware\n","    }\n","\n","@app.post(\"/predict\")\n","async def predict(file: UploadFile = File(...)):\n","\n","    start_time = time.time()\n","\n","    # Read image received through API\n","    content = await file.read()\n","    pil_image = Image.open(BytesIO(content)).convert(\"RGB\")\n","    input_array = np.array(pil_image)\n","\n","    # Run deep learning inference\n","    results = model.predict(\n","        source=input_array,\n","        conf=0.25,\n","        imgsz=640,\n","        verbose=False\n","    )\n","\n","    inference_time = time.time() - start_time\n","\n","    # Extract detected objects\n","    detections = []\n","\n","    for box in results[0].boxes:\n","        class_id = int(box.cls[0])\n","        confidence = float(box.conf[0])\n","\n","        detections.append({\n","            \"object\": model.names[class_id],\n","            \"confidence\": round(confidence * 100, 2),\n","            \"box\": [round(float(x), 2) for x in box.xyxy[0]]\n","        })\n","\n","    return {\n","        \"status\": \"success\",\n","        \"filename\": file.filename,\n","        \"total_objects\": len(detections),\n","        \"inference_time_ms\": round(inference_time * 1000, 2),\n","        \"detections\": detections\n","    }\n","\n","# 7. START FASTAPI SERVER\n","def start_server():\n","    uvicorn.run(\n","        app,\n","        host=\"127.0.0.1\",\n","        port=8000,\n","        log_level=\"error\"\n","    )\n","\n","server_thread = threading.Thread(\n","    target=start_server,\n","    daemon=True\n",")\n","server_thread.start()\n","\n","# Wait for API server\n","api_ready = False\n","\n","for i in range(30):\n","    try:\n","        response = requests.get(\n","            \"http://127.0.0.1:8000/health\",\n","            timeout=2\n","        )\n","        if response.status_code == 200:\n","            api_ready = True\n","            break\n","    except Exception:\n","        time.sleep(1)\n","\n","if not api_ready:\n","    raise RuntimeError(\"FastAPI server failed to start!\")\n","\n","print(\"\\nFASTAPI SERVER STARTED SUCCESSFULLY!\")\n","print(\"API Address: http://127.0.0.1:8000\")\n","print(\"Health Endpoint: /health\")\n","print(\"Prediction Endpoint: /predict\")\n","\n","# 8. SEND IMAGE THROUGH FASTAPI\n","print(\"\\nSending Image Through HTTP POST Request...\")\n","\n","with open(image_path, \"rb\") as f:\n","    api_start = time.time()\n","\n","    api_response = requests.post(\n","        \"http://127.0.0.1:8000/predict\",\n","        files={\n","            \"file\": (\n","                os.path.basename(image_path),\n","                f,\n","                \"image/jpeg\"\n","            )\n","        },\n","        timeout=180\n","    )\n","\n","    api_elapsed = time.time() - api_start\n","\n","if api_response.status_code != 200:\n","    raise RuntimeError(api_response.text)\n","\n","output_data = api_response.json()\n","\n","print(\"\\nAPI RESPONSE RECEIVED!\")\n","print(\"Status:\", output_data[\"status\"])\n","print(\"Total Objects:\", output_data[\"total_objects\"])\n","print(\"Inference Time:\", output_data[\"inference_time_ms\"], \"ms\")\n","\n","# 9. GET DETECTION IMAGE\n","original = cv2.imread(image_path)\n","original_rgb = cv2.cvtColor(original, cv2.COLOR_BGR2RGB)\n","\n","results = model.predict(\n","    source=original_rgb,\n","    conf=0.25,\n","    imgsz=640,\n","    verbose=False\n",")\n","\n","detected_image = results[0].plot()\n","detected_image = cv2.cvtColor(\n","    detected_image,\n","    cv2.COLOR_BGR2RGB\n",")\n","\n","# 10. GRAPHICAL OUTPUT - IMAGE DETECTION\n","plt.figure(figsize=(16, 7))\n","\n","plt.subplot(1, 2, 1)\n","plt.imshow(original_rgb)\n","plt.title(\"Client Input Image\", fontsize=14)\n","plt.axis(\"off\")\n","\n","plt.subplot(1, 2, 2)\n","plt.imshow(detected_image)\n","plt.title(\"VisionPort API - Detected Objects\", fontsize=14)\n","plt.axis(\"off\")\n","\n","plt.tight_layout()\n","plt.show()\n","\n","# 11. GRAPHICAL OUTPUT - ARCHITECTURE\n","fig, ax = plt.subplots(figsize=(12, 9))\n","ax.set_xlim(0, 10)\n","ax.set_ylim(0, 12)\n","ax.axis(\"off\")\n","\n","architecture = [\n","    (\"CLIENT / GOOGLE COLAB\", \"Upload Image\"),\n","    (\"FASTAPI REST API\", \"HTTP POST /predict\"),\n","    (\"TRITON INFERENCE SERVER\",\n","     \"Model Serving Layer - conceptual in this demo\"),\n","    (\"TENSORRT OPTIMIZATION\",\n","     \"GPU Engine - not executed in this demo\"),\n","    (\"YOLOv8 DEEP LEARNING MODEL\", \"Object Detection\"),\n","    (\"GPU / CPU EXECUTION\", hardware),\n","    (\"JSON RESPONSE\", \"Objects + Confidence + Coordinates\")\n","]\n","\n","colors = [\n","    \"#DCEBFF\", \"#D9F5EE\", \"#FCE8D5\",\n","    \"#EADCF8\", \"#DCEBFF\", \"#D9F5EE\", \"#DDF4DC\"\n","]\n","\n","for i, (title, subtitle) in enumerate(architecture):\n","    y = 10.7 - i * 1.5\n","\n","    rect = patches.FancyBboxPatch(\n","        (1.5, y), 7, 0.95,\n","        boxstyle=\"round,pad=0.08\",\n","        facecolor=colors[i],\n","        edgecolor=\"#334155\",\n","        linewidth=1.5\n","    )\n","\n","    ax.add_patch(rect)\n","\n","    ax.text(\n","        5, y + 0.62, title,\n","        ha=\"center\", va=\"center\",\n","        fontsize=11, fontweight=\"bold\"\n","    )\n","\n","    ax.text(\n","        5, y + 0.27, subtitle,\n","        ha=\"center\", va=\"center\",\n","        fontsize=9\n","    )\n","\n","    if i < len(architecture) - 1:\n","        ax.annotate(\n","            \"\", xy=(5, y - 0.48),\n","            xytext=(5, y - 0.05),\n","            arrowprops=dict(arrowstyle=\"->\", lw=1.7)\n","        )\n","\n","plt.title(\n","    \"VISIONPORT - END-TO-END ARCHITECTURE\",\n","    fontsize=15,\n","    fontweight=\"bold\"\n",")\n","plt.tight_layout()\n","plt.show()\n","\n","# 12. GRAPHICAL OUTPUT - OBJECT CONFIDENCE\n","detections = output_data[\"detections\"]\n","\n","if detections:\n","    object_names = [d[\"object\"] for d in detections]\n","    confidence = [d[\"confidence\"] for d in detections]\n","\n","    plt.figure(figsize=(12, 5))\n","\n","    plt.barh(\n","        object_names[::-1],\n","        confidence[::-1]\n","    )\n","\n","    plt.xlabel(\"Confidence (%)\")\n","    plt.ylabel(\"Detected Objects\")\n","    plt.title(\"YOLOv8 Object Detection Confidence\")\n","    plt.xlim(0, 100)\n","    plt.grid(axis=\"x\", alpha=0.3)\n","    plt.tight_layout()\n","    plt.show()\n","\n","# 13. GRAPHICAL OUTPUT - SYSTEM METRICS\n","metrics = {\n","    \"API Request\": api_elapsed * 1000,\n","    \"Model Inference\": output_data[\"inference_time_ms\"]\n","}\n","\n","plt.figure(figsize=(9, 5))\n","plt.bar(\n","    metrics.keys(),\n","    metrics.values()\n",")\n","plt.ylabel(\"Time (milliseconds)\")\n","plt.title(\"VisionPort Request and Inference Timing\")\n","plt.grid(axis=\"y\", alpha=0.3)\n","plt.tight_layout()\n","plt.show()\n","\n","# 14. FINAL SYSTEM REPORT\n","print(\"\\n\" + \"=\" * 65)\n","print(\"             VISIONPORT FINAL SYSTEM REPORT\")\n","print(\"=\" * 65)\n","\n","print(\"Image Acquisition       : SUCCESS\")\n","print(\"FastAPI Server           : RUNNING\")\n","print(\"HTTP POST Request        : SUCCESS\")\n","print(\"YOLOv8 Model             : LOADED\")\n","print(\"Object Detection         : COMPLETED\")\n","print(\"Bounding Boxes           : GENERATED\")\n","print(\"JSON Response            : RECEIVED\")\n","print(\"GPU Available            :\", gpu_available)\n","print(\"TensorRT Available       :\", tensorrt_available)\n","print(\"Triton Client Available  :\", triton_client_available)\n","print(\"Triton Server Running    :\", triton_running)\n","print(\"Total Objects Detected   :\", len(detections))\n","print(\"Inference Time           :\",\n","      output_data[\"inference_time_ms\"], \"ms\")\n","print(\"=\" * 65)\n","\n","print(\"\\nVISIONPORT END-TO-END PIPELINE COMPLETED!\")\n"]}]}