iv>\n","\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","summary":"{\n  \"name\": \"print(\\\"=\\\" * 60)\",\n  \"rows\": 20,\n  \"fields\": [\n    {\n      \"column\": \"Image\",\n      \"properties\": {\n        \"dtype\": \"category\",\n        \"num_unique_values\": 6,\n        \"samples\": [\n          \"000000000094.jpg\",\n          \"000000000086.jpg\",\n          \"000000000540.jpg\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Category\",\n      \"properties\": {\n        \"dtype\": \"category\",\n        \"num_unique_values\": 7,\n        \"samples\": [\n          \"car\",\n          \"truck\",\n          \"bus\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"X Center\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.24569794656726057,\n        \"min\": 0.1226,\n        \"max\": 0.9623,\n        \"num_unique_values\": 20,\n        \"samples\": [\n          0.5901,\n          0.1539,\n          0.2658\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Y Center\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.1580394683382337,\n        \"min\": 0.3473,\n        \"max\": 0.9624,\n        \"num_unique_values\": 20,\n        \"samples\": [\n          0.6896,\n          0.8762,\n          0.9396\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Width\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.19251949586853193,\n        \"min\": 0.0028,\n        \"max\": 0.6522,\n        \"num_unique_values\": 20,\n        \"samples\": [\n          0.067,\n          0.0341,\n          0.0242\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Height\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.14896029310206338,\n        \"min\": 0.0045,\n        \"max\": 0.5348,\n        \"num_unique_values\": 20,\n        \"samples\": [\n          0.0901,\n          0.0585,\n          0.0238\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","============================================================\n","       FINAL TRAFFIC DATASET REPORT\n","============================================================\n","Total Dataset Images : 128\n","Traffic Images       : 22\n","Traffic Categories   : 7\n","Total Annotations    : 90\n","\n","CATEGORY COUNTS\n","car : 46\n","truck : 12\n","motorcycle : 5\n","stop sign : 1\n","bicycle : 6\n","bus : 7\n","traffic light : 13\n","\n","Average Objects Per Image: 4.09\n","Average Box Width: 0.1239\n","Average Box Height: 0.1124\n","\n","EXPERIMENT COMPLETED SUCCESSFULLY!\n","============================================================\n"]}],"source":["\n","# ================================================================\n","# DEEP LEARNING SKILL LAB\n","# COCO DATASET EXPLORATION - TRAFFIC IMAGE PROCESSING\n","# REAL PHOTOGRAPHS + BOUNDING BOX ANNOTATIONS\n","# ================================================================\n","\n","!pip install -q numpy pandas matplotlib seaborn pillow\n","\n","import os\n","import glob\n","import zipfile\n","import random\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import matplotlib.patches as patches\n","import seaborn as sns\n","\n","from PIL import Image\n","from collections import Counter\n","from google.colab import files\n","from IPython.display import display\n","\n","sns.set_theme(style=\"whitegrid\")\n","random.seed(42)\n","\n","print(\"=\" * 65)\n","print(\"       COCO TRAFFIC DATASET EXPLORATION\")\n","print(\"=\" * 65)\n","\n","# 1. UPLOAD COCO ZIP FILE\n","print(\"\\nPLEASE UPLOAD YOUR COCO128 ZIP FILE\")\n","\n","uploaded = files.upload()\n","\n","zip_file = next(\n","    (f for f in uploaded if f.lower().endswith(\".zip\")),\n","    None\n",")\n","\n","if zip_file is None:\n","    raise ValueError(\"Please upload the COCO ZIP file!\")\n","\n","# 2. EXTRACT DATASET\n","dataset_path = \"/content/traffic_coco\"\n","\n","os.makedirs(dataset_path, exist_ok=True)\n","\n","with zipfile.ZipFile(zip_file, \"r\") as z:\n","    z.extractall(dataset_path)\n","\n","print(\"\\nDataset extracted successfully!\")\n","\n","# 3. FIND IMAGE AND LABEL FOLDERS\n","image_files = glob.glob(\n","    dataset_path + \"/**/images/**/*.jpg\",\n","    recursive=True\n",")\n","\n","if not image_files:\n","    image_files = glob.glob(\n","        dataset_path + \"/**/*.jpg\",\n","        recursive=True\n","    )\n","\n","label_files = glob.glob(\n","    dataset_path + \"/**/labels/**/*.txt\",\n","    recursive=True\n",")\n","\n","if not image_files:\n","    raise FileNotFoundError(\"No images found in ZIP!\")\n","\n","if not label_files:\n","    raise FileNotFoundError(\"No YOLO annotation files found!\")\n","\n","label_lookup = {\n","    os.path.splitext(os.path.basename(p))[0]: p\n","    for p in label_files\n","}\n","\n","print(\"Total photographs:\", len(image_files))\n","print(\"Total annotation files:\", len(label_files))\n","\n","# 4. COCO CATEGORY NAMES\n","class_names = [\n","    \"person\", \"bicycle\", \"car\", \"motorcycle\", \"airplane\",\n","    \"bus\", \"train\", \"truck\", \"boat\", \"traffic light\",\n","    \"fire hydrant\", \"stop sign\", \"parking meter\", \"bench\",\n","    \"bird\", \"cat\", \"dog\", \"horse\", \"sheep\", \"cow\",\n","    \"elephant\", \"bear\", \"zebra\", \"giraffe\", \"backpack\",\n","    \"umbrella\", \"handbag\", \"tie\", \"suitcase\", \"frisbee\",\n","    \"skis\", \"snowboard\", \"sports ball\", \"kite\",\n","    \"baseball bat\", \"baseball glove\", \"skateboard\",\n","    \"surfboard\", \"tennis racket\", \"bottle\", \"wine glass\",\n","    \"cup\", \"fork\", \"knife\", \"spoon\", \"bowl\", \"banana\",\n","    \"apple\", \"sandwich\", \"orange\", \"broccoli\", \"carrot\",\n","    \"hot dog\", \"pizza\", \"donut\", \"cake\", \"chair\", \"couch\",\n","    \"potted plant\", \"bed\", \"dining table\", \"toilet\", \"tv\",\n","    \"laptop\", \"mouse\", \"remote\", \"keyboard\", \"cell phone\",\n","    \"microwave\", \"oven\", \"toaster\", \"sink\", \"refrigerator\",\n","    \"book\", \"clock\", \"vase\", \"scissors\", \"teddy bear\",\n","    \"hair drier\", \"toothbrush\"\n","]\n","\n","# 5. SELECT TRAFFIC OBJECTS\n","# Exclude person-only images.\n","# Main vehicle classes:\n","vehicle_ids = [1, 2, 3, 5, 7]\n","\n","# Additional road-related objects:\n","road_ids = [9, 11, 12]\n","\n","# Require at least one actual vehicle.\n","traffic_records = []\n","category_counts = Counter()\n","\n","for image_path in image_files:\n","\n","    name = os.path.splitext(\n","        os.path.basename(image_path)\n","    )[0]\n","\n","    label_path = label_lookup.get(name)\n","\n","    if not label_path:\n","        continue\n","\n","    objects = []\n","\n","    with open(label_path, \"r\") as f:\n","        lines = f.readlines()\n","\n","    for line in lines:\n","\n","        values = list(map(float, line.split()))\n","\n","        if len(values) < 5:\n","            continue\n","\n","        cid = int(values[0])\n","\n","        if cid not in vehicle_ids + road_ids:\n","            continue\n","\n","        xc, yc, w, h = values[1:5]\n","\n","        obj = {\n","            \"id\": cid,\n","            \"name\": class_names[cid],\n","            \"xc\": xc,\n","            \"yc\": yc,\n","            \"w\": w,\n","            \"h\": h\n","        }\n","\n","        objects.append(obj)\n","\n","    # Only keep images containing a vehicle.\n","    has_vehicle = any(\n","        obj[\"id\"] in vehicle_ids for obj in objects\n","    )\n","\n","    if has_vehicle:\n","\n","        traffic_records.append({\n","            \"path\": image_path,\n","            \"objects\": objects\n","        })\n","\n","        for obj in objects:\n","            category_counts[obj[\"name\"]] += 1\n","\n","print(\"\\nTRAFFIC IMAGES FOUND:\", len(traffic_records))\n","\n","if not traffic_records:\n","    raise ValueError(\n","        \"No vehicle images found in this dataset. \"\n","        \"Please check that you uploaded COCO128.\"\n","    )\n","\n","# 6. DISPLAY REAL TRAFFIC PHOTOGRAPHS\n","print(\"\\nREAL TRAFFIC PHOTOGRAPHS WITH BOUNDING BOXES\")\n","\n","sample = random.sample(\n","    traffic_records,\n","    min(9, len(traffic_records))\n",")\n","\n","fig, axes = plt.subplots(3, 3, figsize=(20, 15))\n","axes = axes.flatten()\n","\n","for ax, record in zip(axes, sample):\n","\n","    img = Image.open(record[\"path\"]).convert(\"RGB\")\n","\n","    width, height = img.size\n","\n","    ax.imshow(img)\n","\n","    for obj in record[\"objects\"]:\n","\n","        # Normalized YOLO coordinates to pixels\n","        xc = obj[\"xc\"] * width\n","        yc = obj[\"yc\"] * height\n","        bw = obj[\"w\"] * width\n","        bh = obj[\"h\"] * height\n","\n","        x = xc - bw / 2\n","        y = yc - bh / 2\n","\n","        rectangle = patches.Rectangle(\n","            (x, y),\n","            bw,\n","            bh,\n","            linewidth=2,\n","            edgecolor=\"lime\",\n","            facecolor=\"none\"\n","        )\n","\n","        ax.add_patch(rectangle)\n","\n","        ax.text(\n","            x,\n","            max(0, y - 5),\n","            obj[\"name\"],\n","            color=\"white\",\n","            fontsize=9,\n","            bbox=dict(\n","                facecolor=\"green\",\n","                alpha=0.8\n","            )\n","        )\n","\n","    ax.set_title(\n","        os.path.basename(record[\"path\"]),\n","        fontsize=10\n","    )\n","\n","    ax.axis(\"off\")\n","\n","for ax in axes[len(sample):]:\n","    ax.axis(\"off\")\n","\n","plt.suptitle(\n","    \"REAL TRAFFIC IMAGES - VEHICLE DETECTION\",\n","    fontsize=22,\n","    fontweight=\"bold\"\n",")\n","\n","plt.tight_layout()\n","plt.show()\n","\n","# 7. CATEGORY DISTRIBUTION\n","names = list(category_counts.keys())\n","counts = list(category_counts.values())\n","\n","plt.figure(figsize=(12, 6))\n","\n","sns.barplot(\n","    x=names,\n","    y=counts\n",")\n","\n","plt.title(\"Traffic Vehicle Category Distribution\")\n","plt.xlabel(\"Traffic Categories\")\n","plt.ylabel(\"Number of Annotations\")\n","plt.xticks(rotation=35)\n","plt.tight_layout()\n","plt.show()\n","\n","# 8. CATEGORY PIE CHART\n","plt.figure(figsize=(9, 9))\n","\n","plt.pie(\n","    counts,\n","    labels=names,\n","    autopct=\"%1.1f%%\",\n","    startangle=90\n",")\n","\n","plt.title(\"Traffic Object Percentage Distribution\")\n","plt.show()\n","\n","# 9. BOUNDING BOX ANALYSIS\n","widths = [\n","    obj[\"w\"]\n","    for record in traffic_records\n","    for obj in record[\"objects\"]\n","]\n","\n","heights = [\n","    obj[\"h\"]\n","    for record in traffic_records\n","    for obj in record[\"objects\"]\n","]\n","\n","plt.figure(figsize=(12, 5))\n","\n","plt.hist(widths, bins=25, alpha=0.7, label=\"Width\")\n","plt.hist(heights, bins=25, alpha=0.7, label=\"Height\")\n","\n","plt.title(\"Traffic Bounding Box Dimensions\")\n","plt.xlabel(\"Normalized Dimensions\")\n","plt.ylabel(\"Frequency\")\n","plt.legend()\n","plt.show()\n","\n","# 10. OBJECTS PER IMAGE\n","objects_per_image = [\n","    len(record[\"objects\"])\n","    for record in traffic_records\n","]\n","\n","plt.figure(figsize=(10, 5))\n","\n","plt.hist(objects_per_image, bins=15, edgecolor=\"black\")\n","\n","plt.title(\"Number of Traffic Objects Per Image\")\n","plt.xlabel(\"Number of Objects\")\n","plt.ylabel(\"Number of Images\")\n","\n","plt.show()\n","\n","# 11. ANNOTATION TABLE\n","rows = []\n","\n","for record in traffic_records:\n","\n","    for obj in record[\"objects\"]:\n","\n","        rows.append({\n","            \"Image\": os.path.basename(record[\"path\"]),\n","            \"Category\": obj[\"name\"],\n","            \"X Center\": round(obj[\"xc\"], 4),\n","            \"Y Center\": round(obj[\"yc\"], 4),\n","            \"Width\": round(obj[\"w\"], 4),\n","            \"Height\": round(obj[\"h\"], 4)\n","        })\n","\n","df = pd.DataFrame(rows)\n","\n","print(\"\\nANNOTATION TABLE\")\n","display(df.head(20))\n","\n","# 12. FINAL REPORT\n","print(\"\\n\" + \"=\" * 60)\n","print(\"       FINAL TRAFFIC DATASET REPORT\")\n","print(\"=\" * 60)\n","\n","print(\"Total Dataset Images :\", len(image_files))\n","print(\"Traffic Images       :\", len(traffic_records))\n","print(\"Traffic Categories   :\", len(names))\n","print(\"Total Annotations    :\", len(df))\n","\n","print(\"\\nCATEGORY COUNTS\")\n","\n","for name, count in category_counts.items():\n","    print(name, \":\", count)\n","\n","print(\"\\nAverage Objects Per Image:\",\n","      round(np.mean(objects_per_image), 2))\n","\n","print(\"Average Box Width:\",\n","      round(np.mean(widths), 4))\n","\n","print(\"Average Box Height:\",\n","      round(np.mean(heights), 4))\n","\n","print(\"\\nEXPERIMENT COMPLETED SUCCESSFULLY!\")\n","print(\"=\" * 60)\n"]},{"cell_type":"code","source":[],"metadata":{"id":"oBFYdt6IjBN0"},"execution_count":null,"outputs":[]}]}